# Apollo Platform Environment Variables
# Copy this file to .env.local in the packages/hub directory

# Module URLs - URLs for microfrontend modules embedded in iframes
# These must be prefixed with NEXT_PUBLIC_ to be available in the browser

# Employees module URL (default: http://localhost:3001)
NEXT_PUBLIC_EMPLOYEES_URL=http://localhost:3001

# Payroll module URL (default: http://localhost:3002)
NEXT_PUBLIC_PAYROLL_URL=http://localhost:3002

# Benefits module URL (default: http://localhost:3003)
NEXT_PUBLIC_BENEFITS_URL=http://localhost:3003
